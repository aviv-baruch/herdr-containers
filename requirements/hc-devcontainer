#!/usr/bin/env python3
"""List Docker containers and run a herdr-core connection line in one."""

import argparse
import json
import os
import posixpath
import re
import shlex
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.parse

FOLDER_LABELS = ("devcontainer.local_folder", "vsch.local.folder")
ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
ENV_REFERENCE = re.compile(r"\$\{(containerEnv|localEnv):([^}:]+)(?::([^}]*))?\}")
WINDOWS = os.name == "nt"
DRIVE_PATH = re.compile(r"([A-Za-z]):(?:[\\/](.*))?\Z", re.S)
# Docker Desktop (WSL 2, Hyper-V) and WSL spell a Windows drive inside Linux.
DRIVE_MOUNT = re.compile(r"/(?:run/desktop/mnt/host|host_mnt|mnt)/([A-Za-z])(?:/(.*))?\Z", re.S)


def metadata(raw):
    try:
        entries = json.loads(raw or "[]")
    except (TypeError, ValueError):
        return []
    if isinstance(entries, dict):
        entries = [entries]
    return [entry for entry in entries if isinstance(entry, dict)] if isinstance(entries, list) else []


def metadata_user(raw):
    remote = container = None
    for entry in metadata(raw):
        if isinstance(entry.get("remoteUser"), str) and entry["remoteUser"]:
            remote = entry["remoteUser"]
        if isinstance(entry.get("containerUser"), str) and entry["containerUser"]:
            container = entry["containerUser"]
    return remote or container


def metadata_has_feature(raw):
    # ghcr.io/o/r/herdr-core:1, ./herdr-core, …/herdr-core@sha256:…
    return any(re.split(r"[:@]", str(entry.get("id", "")).rsplit("/", 1)[-1])[0] == "herdr-core"
               for entry in metadata(raw))


def metadata_remote_env(raw, container_env):
    base = {}
    for item in container_env or []:
        if isinstance(item, str) and "=" in item:
            name, value = item.split("=", 1)
            base[name] = value

    def resolve(match):
        source = base if match[1] == "containerEnv" else os.environ
        return source.get(match[2], match[3] or "")

    remote = {}
    for entry in metadata(raw):
        values = entry.get("remoteEnv")
        if not isinstance(values, dict):
            continue
        for name, value in values.items():
            if not isinstance(name, str) or not ENV_NAME.fullmatch(name):
                continue
            if value is None:
                remote.pop(name, None)
            elif isinstance(value, str):
                remote[name] = ENV_REFERENCE.sub(resolve, value)
    return remote


def base_name(path):
    # Docker Desktop labels hold Windows paths whatever the helper runs on.
    return re.split(r"[\\/]", path.rstrip("\\/"))[-1]


def host_parts(path):
    """A host path as parts; a Windows drive becomes "c:" however it is spelled."""
    if WINDOWS or not DRIVE_PATH.match(path):
        path = os.path.realpath(path)
    drive = DRIVE_PATH.match(path) or DRIVE_MOUNT.match(path)
    if drive:
        return [f"{drive[1].lower()}:", *(p for p in re.split(r"[\\/]", drive[2] or "") if p)]
    return [p for p in re.split(r"[\\/]" if WINDOWS else "/", path) if p]


def folded(parts):
    # Windows paths ignore case.
    return [p.lower() for p in parts] if WINDOWS or (parts and DRIVE_PATH.match(parts[0])) else parts


def machine_name(folder):
    raw = base_name(folder)
    ascii_lower = "".join(c.lower() if c.isascii() else "-" for c in raw)
    name = "".join(c if c.isalnum() or c in "-_." else "-"
                   for c in ascii_lower).lstrip("-_.")[:32]
    # Not "local": shipped Spaces ids its own machine group machine-local.
    if not name or re.fullmatch(r"t[1-9][0123456789bcdfghjkmnpqrstvwxyz]*", name):
        return "container"
    return name


# $BROWSER in the container: queue each URL for `serve` on the host. Without a
# live listener, print it so it can still be clicked.
BROWSER_HELPER = """#!/bin/sh
dir=$(dirname -- "$0")
pid=$(cat "$dir/serve.lock/pid" 2>/dev/null) &&
    tr '\\0' ' ' 2>/dev/null <"/proc/$pid/cmdline" | grep -q hc-devcontainer-serve || {
    printf 'Open this link: %s\\n' "$@" >&2
    exit 1
}
for url do printf '%s\\n' "$url" >>"$dir/open"; done
"""

# One listener per container user (hc-devcontainer-serve marks its cmdline).
# Prints "open URL" and, on change, "ports ADDR:PORT…" (hex, /proc/net/tcp*).
# Exit 3: another runs; 4: no home to work in.
LISTEN = """# hc-devcontainer-serve
umask 077
dir="$HOME/.cache/herdr-containers"
lock="$dir/serve.lock"
mkdir -p "$dir" 2>/dev/null || exit 4
if ! mkdir "$lock" 2>/dev/null; then
    pid=$(cat "$lock/pid" 2>/dev/null) || exit 3
    tr '\\0' ' ' 2>/dev/null <"/proc/$pid/cmdline" | grep -q hc-devcontainer-serve && exit 3
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || exit 3
fi
echo $$ >"$lock/pid"
# docker exec keeps a process whose client left; only its stdin closes.
# (A background job's stdin is /dev/null, so hand it over as fd 3.)
exec 3<&0
(cat <&3 >/dev/null; kill $$) &
exec 3<&-
rm -f "$dir/open"
last=
while :; do
    if [ -s "$dir/open" ] && mv -f "$dir/open" "$dir/open.$$" 2>/dev/null; then
        sed 's/^/open /' "$dir/open.$$" || exit 0
        rm -f "$dir/open.$$"
    fi
    ports=$(awk '$4 == "0A" { print $2 }' /proc/net/tcp /proc/net/tcp6 2>/dev/null | sort -u | tr '\\n' ' ')
    if [ "$ports" != "$last" ]; then
        echo "ports $ports" || exit 0
        last=$ports
    fi
    sleep 1
done
"""

# Carries one forwarded TCP connection over docker exec's stdin and stdout.
RELAY = """if command -v python3 >/dev/null 2>&1; then
    exec python3 -c '
import os, socket, sys, threading
s = socket.create_connection((sys.argv[1], int(sys.argv[2])))
def up():
    while data := sys.stdin.buffer.read1(65536):
        s.sendall(data)
    s.shutdown(socket.SHUT_WR)
threading.Thread(target=up, daemon=True).start()
while data := s.recv(65536):
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()
os._exit(0)  # the stdin thread would abort a normal exit
' "$1" "$2"
elif command -v bash >/dev/null 2>&1; then
    # The server's side ends the relay; stdin goes over fd 4 (see LISTEN).
    exec bash -c 'exec 3<>"/dev/tcp/$1/$2" 4<&0 || exit 1; cat <&4 >&3 & exec 4<&-; cat <&3; kill $!' \
        bash "$1" "$2"
elif command -v nc >/dev/null 2>&1; then
    # Some nc builds outlast the server until stdin closes too.
    exec nc "$1" "$2"
fi
exit 127
"""

# /proc/net/tcp* local addresses worth forwarding: wildcard and loopback.
LOOPBACK = {"00000000": "127.0.0.1", "0100007F": "127.0.0.1", "0" * 32: "::1",
            "00000000000000000000000001000000": "::1", "0000000000000000FFFF00000100007F": "127.0.0.1"}
LOCAL_HOSTS = {"localhost", "127.0.0.1", "0.0.0.0", "::1", "::"}


def listening(ports_line):
    """{port: address to dial} for loopback and wildcard listeners."""
    found = {}
    for item in ports_line.split():
        address, _, port = item.partition(":")
        target = LOOPBACK.get(address.upper())
        try:
            number = int(port, 16)
        except ValueError:
            continue
        if target and number:
            found.setdefault(number, target)
    return found


def host_opener():
    if os.environ.get("HC_DEVCONTAINER_OPEN"):
        return shlex.split(os.environ["HC_DEVCONTAINER_OPEN"])
    if WINDOWS:
        return ["explorer.exe"]
    if sys.platform == "darwin":
        return ["open"]
    try:
        with open("/proc/sys/kernel/osrelease", encoding="utf-8") as stream:
            wsl = "microsoft" in stream.read().lower()
    except OSError:
        wsl = False
    if wsl:
        # The Windows browser, as VS Code uses; WSL forwards localhost to it.
        found = shutil.which("wslview") or shutil.which("explorer.exe")
        if found or os.path.exists("/mnt/c/Windows/explorer.exe"):
            return [found or "/mnt/c/Windows/explorer.exe"]
    return ["xdg-open"]


class Server:
    """Opens the container's links here and forwards its listening ports."""

    def __init__(self, docker, container, user):
        self.docker, self.container, self.user = docker, container, user
        self.forwards = {}  # container port: (listening socket, host port)
        self.targets = {}
        self.lock = threading.Lock()
        self.proc = None
        self.stopped = False

    def exec_argv(self, script, *args):
        return [self.docker, "exec", "-i", *(["-u", self.user] if self.user else []),
                self.container, "sh", "-c", script, "sh", *args]

    def relay(self, client, port):
        target = self.targets.get(port, "127.0.0.1")
        try:
            proc = subprocess.Popen(self.exec_argv(RELAY, target, str(port)), stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            client.close()
            return

        def up():
            try:
                while data := client.recv(65536):
                    proc.stdin.write(data)
                    proc.stdin.flush()
            except (OSError, ValueError):
                pass
            try:
                proc.stdin.close()
            except OSError:
                pass

        threading.Thread(target=up, daemon=True).start()
        try:
            while data := proc.stdout.read1(65536):
                client.sendall(data)
        except OSError:
            pass
        finally:
            # close() alone leaves the up thread's recv() holding the connection open.
            try:
                client.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            client.close()
            proc.kill()
            proc.wait()
            proc.stdout.close()

    def accept(self, listener, port):
        while True:
            try:
                client, _ = listener.accept()
            except OSError:
                return
            threading.Thread(target=self.relay, args=(client, port), daemon=True).start()

    def forward(self, port):
        """The host port that reaches the container's port, or None."""
        with self.lock:
            if port in self.forwards:
                return self.forwards[port][1]
            # Same port first: clicked links and OAuth callbacks name it.
            for host_port in (port, 0):
                listener = socket.socket()
                try:
                    listener.bind(("127.0.0.1", host_port))
                    listener.listen()
                except OSError:
                    listener.close()
                    continue
                bound = listener.getsockname()[1]
                self.forwards[port] = (listener, bound)
                threading.Thread(target=self.accept, args=(listener, port), daemon=True).start()
                return bound
        return None

    def ports(self, line):
        found = listening(line)
        self.targets.update(found)
        with self.lock:
            gone = [port for port in self.forwards if port not in found]
            for port in gone:
                listener = self.forwards.pop(port)[0]
                try:
                    listener.shutdown(socket.SHUT_RDWR)  # wakes accept(); close() would not
                except OSError:
                    pass
                listener.close()
        for port in found:
            self.forward(port)

    def open(self, url):
        try:
            parts = urllib.parse.urlsplit(url.strip())
            port = parts.port
        except ValueError:
            return
        if parts.scheme not in ("http", "https") or not parts.hostname:
            return
        if parts.hostname in LOCAL_HOSTS:
            host_port = self.forward(port or (443 if parts.scheme == "https" else 80))
            if host_port:
                host = {"0.0.0.0": "localhost", "::": "localhost", "::1": "[::1]"}.get(parts.hostname, parts.hostname)
                parts = parts._replace(netloc=f"{host}:{host_port}")
        try:
            subprocess.Popen([*host_opener(), urllib.parse.urlunsplit(parts)], stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass

    def listen_once(self):
        """Runs one listener to its end; returns its exit code."""
        with self.lock:
            if self.stopped:
                return 4
            proc = self.proc = subprocess.Popen(self.exec_argv(LISTEN), stdin=subprocess.PIPE,
                                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        for line in proc.stdout:
            kind, _, rest = line.rstrip("\n").partition(" ")
            if kind == "open":
                self.open(rest)
            elif kind == "ports":
                self.ports(rest)
        proc.stdout.close()
        return proc.wait()

    def run(self):
        """Keeps one listener running until stop(), or until there is no home."""
        while self.listen_once() != 4:
            self.ports("")
            time.sleep(2)

    def stop(self):
        with self.lock:
            self.stopped = True
            if self.proc:
                self.proc.kill()


def serve(docker, container, user, parent):
    """Serves until the connection process `parent` ends (POSIX reparents us)."""
    server = Server(docker, container, user)

    def watch():
        while os.getppid() == parent:
            time.sleep(1)
        server.stop()
        os._exit(0)

    threading.Thread(target=watch, daemon=True).start()
    server.run()


def serve_in_background(docker, container_id, user):
    # A child of this process, which becomes the connection's docker exec.
    try:
        subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "serve", container_id,
                          user or "", str(os.getpid())], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def exec_argv(docker, container_id, user, line, remote_env=None, workspace=""):
    # Core starts terminals in its own folder when Herdr names none; the image's
    # WORKDIR is often empty (/), so start in the workspace when it exists.
    script = """if [ -z "${SHELL:-}" ]; then
    unset SHELL
    user=$(id -un)
    if command -v getent >/dev/null 2>&1; then
        shell=$(getent passwd "$user" | awk -F: -v user="$user" '$1 == user { print $7; exit }')
    else
        shell=$(awk -F: -v user="$user" '$1 == user { print $7; exit }' /etc/passwd)
    fi
    [ -z "$shell" ] || export SHELL="$shell"
fi
# stdout carries the connection: cd must never print.
[ "$#" -lt 2 ] || cd -- "$2" >/dev/null 2>&1 || :
# Like VS Code's helper: programs hand links to the host (see serve).
# Private: another user who could edit it would run code as this one.
dir="${HOME:-/nonexistent}/.cache/herdr-containers"
if [ -z "${BROWSER:-}" ] && (umask 077 && mkdir -p "$dir" && cat >"$dir/browser.$$" <<'HC_BROWSER' &&
""" + BROWSER_HELPER + """HC_BROWSER
        chmod 700 "$dir" && chmod 755 "$dir/browser.$$" && mv -f "$dir/browser.$$" "$dir/browser") 2>/dev/null; then
    export BROWSER="$dir/browser"
fi
rm -f "$dir/browser.$$" 2>/dev/null
unset dir
exec sh -c "$1"
"""
    return [docker, "exec", "-i", *(["-u", user] if user else []),
            *(part for name in (remote_env or {}) if isinstance(name, str) and ENV_NAME.fullmatch(name)
              for part in ("-e", name)),
            container_id, "sh", "-c", script, "sh", line, *([workspace] if workspace else [])]


def exec_container(docker, row, container_id, line):
    remote = {name: value for name, value in row.get("remote_env", {}).items()
              if isinstance(name, str) and ENV_NAME.fullmatch(name)}
    env = {**os.environ, **remote}
    # A remote PATH must not change where the host finds Docker.
    executable = (shutil.which(docker) or docker) if "PATH" in remote else docker
    argv = exec_argv(docker, container_id, row["user"], line, remote, row.get("workspace"))
    if WINDOWS:
        # Windows has no exec: os.exec* starts a child and exits at once, ending the connection.
        # Its children are not reparented either, so serve in this process instead.
        server = Server(docker, container_id, row["user"])
        threading.Thread(target=server.run, daemon=True).start()
        try:
            return subprocess.run([executable, *argv[1:]], env=env, check=False).returncode
        finally:
            server.stop()
    serve_in_background(docker, container_id, row["user"])
    os.execvpe(executable, argv, env)


def shell_quote(value):
    return "'" + value.replace("'", "'\\''") + "'"


def same_folder(a, b):
    return folded(host_parts(a)) == folded(host_parts(b))


def workspace_for(folder, mounts, working_dir, devcontainer=False, repo_folder=""):
    best = None
    if folder:
        parts = host_parts(folder)
        key = folded(parts)
        for mount in mounts:
            if mount.get("Type", "bind") != "bind":
                continue
            source, dest = mount.get("Source"), mount.get("Destination")
            if not source or not dest:
                continue
            source = folded(host_parts(source))
            if key[:len(source)] == source and (best is None or len(source) > best[0]):
                best = (len(source), dest)
    if best:
        depth, dest = best
        return posixpath.normpath(posixpath.join(dest, *parts[depth:]))
    if devcontainer:
        dests = {posixpath.normpath(m.get("Destination") or "/") for m in mounts}
        # VS Code's Clone in Volume: the volume is /workspaces, the repo a folder in it.
        if repo_folder not in ("", ".", "..") and "/" not in repo_folder and "/workspaces" in dests:
            return f"/workspaces/{repo_folder}"
        # A repo mounted from elsewhere at /workspaces/<name>: only a guess, so only when the
        # image names no folder of its own, and only when unambiguous.
        found = sorted(d for d in dests if posixpath.dirname(d) == "/workspaces"
                       and (working_dir or "/") == "/")
        named = f"/workspaces/{base_name(folder)}" if folder else None
        if named in found:
            return named
        if len(found) == 1:
            return found[0]
    return working_dir if working_dir and working_dir != "/" else ""


def run(argv):
    try:
        result = subprocess.run(argv, capture_output=True, text=True, check=False)
    except OSError as error:
        raise RuntimeError(f"cannot run {argv[0]}: {error}") from error
    if result.returncode:
        raise RuntimeError((result.stderr or f"{argv[0]} {argv[1]} failed").strip())
    return result.stdout


def ps(docker, *extra):
    return run([docker, "ps", "-q", *extra]).split()


def folder_ids(docker, *extra):
    return [i for label in FOLDER_LABELS for i in ps(docker, *extra, "--filter", f"label={label}")]


def inspect(docker, ids):
    ids = list(dict.fromkeys(ids))
    if not ids:
        return []
    output = run([docker, "inspect", "--type", "container", *ids])
    try:
        return json.loads(output)
    except ValueError as error:
        raise RuntimeError(f"invalid {docker} inspect output: {error}") from error


def rows(containers):
    found = []
    for item in containers:
        docker_state = item.get("State") or {}
        state = docker_state.get("Status") or ("running" if docker_state.get("Running", True) else "exited")
        config = item.get("Config") or {}
        labels = config.get("Labels") or {}
        folder = labels.get("devcontainer.local_folder") or labels.get("vsch.local.folder") or ""
        raw = labels.get("devcontainer.metadata")
        # Folderless CLI builds use vsc-* images; metadata on other images alone is insufficient.
        devcontainer = bool(folder or "vsch.local.repository" in labels
                            or ("devcontainer.metadata" in labels and re.fullmatch(r"vsc-.+", config.get("Image") or "")))
        name = item.get("Name", "").lstrip("/")
        row = {
            "folder": folder,
            "name": name,
            "id": item["Id"],
            "kind": "devcontainer" if devcontainer else "container",
            "state": state,
            "has_feature": devcontainer and metadata_has_feature(raw),
            "workspace": workspace_for(folder, item.get("Mounts") or [], config.get("WorkingDir"), devcontainer,
                                       labels.get("vsch.local.repository.folder") or ""),
            "user": metadata_user(raw) or config.get("User") or None,
            "image": config.get("Image", ""),
            "via": f"hc-devcontainer {shell_quote(folder)}" if folder else f"hc-devcontainer --container {shell_quote(name)}",
            "suggested_name": machine_name(folder if folder else name),
            "created": item.get("Created", ""),
        }
        remote_env = metadata_remote_env(raw, config.get("Env"))
        if remote_env:
            row["remote_env"] = remote_env
        found.append(row)
    found.sort(key=lambda row: (row["kind"] != "devcontainer", row["folder"], row["name"]))
    seen = set()
    for row in found:
        base = row["suggested_name"]
        name = base
        suffix = 2
        while name in seen:
            tail = f"-{suffix}"
            name = f"{base[:32 - len(tail)]}{tail}"
            suffix += 1
        row["suggested_name"] = name
        seen.add(name)
    return found


def exists(docker, via):
    """0: the via's container exists (any state), 1: it is gone; errors raise."""
    parts = shlex.split(via)
    if parts[:1] != ["hc-devcontainer"] or len(parts) != (3 if parts[1:2] == ["--container"] else 2):
        raise ValueError(f"not an hc-devcontainer via: {via!r}")
    if len(parts) == 2:
        found = [row for row in rows(inspect(docker, folder_ids(docker, "-a"))) if same_folder(row["folder"], parts[1])]
        return 0 if found else 1
    try:
        inspect(docker, [parts[2]])
    except RuntimeError as error:
        if "no such" in str(error).lower():  # docker: No such object/container; podman: no such container
            return 1
        raise
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    docker = os.environ.get("HC_DEVCONTAINER_DOCKER") or "docker"
    if argv and argv[0] == "ls":
        parser = argparse.ArgumentParser(prog="hc-devcontainer ls")
        parser.add_argument("--all", action="store_true")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args(argv[1:])
        # Running and paused containers, and with --all stopped dev ones too.
        ids = ps(docker) + (folder_ids(docker, "-a") + ps(docker, "-a", "--filter", "label=devcontainer.metadata") if args.all else [])
        found = rows(inspect(docker, ids))
        if args.all:
            found = [row for row in found if row["kind"] == "devcontainer" or row["state"] in ("running", "paused")]
        if not args.all:
            found = [row for row in found if row["kind"] == "devcontainer" and row["state"] == "running"]
        if args.json:
            for row in found:
                row.pop("created")
                row.pop("remote_env", None)
            print(json.dumps(found))
        else:
            for row in found:
                print(f"{row['suggested_name']}\t{row['folder']}\t{row['name']}\t{row['id']}")
        return 0

    if argv and argv[0] == "start":
        parser = argparse.ArgumentParser(prog="hc-devcontainer start")
        parser.add_argument("id")
        args = parser.parse_args(argv[1:])
        run([docker, "start", args.id])
        return 0

    if argv and argv[0] == "serve":
        parser = argparse.ArgumentParser(prog="hc-devcontainer serve",
                                         description="Internal: open a connection's links and forward its ports.")
        parser.add_argument("id")
        parser.add_argument("user")
        parser.add_argument("parent", type=int)
        args = parser.parse_args(argv[1:])
        serve(docker, args.id, args.user or None, args.parent)
        return 0

    if argv and argv[0] == "exists":
        parser = argparse.ArgumentParser(prog="hc-devcontainer exists",
                                         description="Exit 0 if the container exists, 1 if gone, 2 on error.")
        parser.add_argument("via")
        args = parser.parse_args(argv[1:])
        try:
            return exists(docker, args.via)
        except (RuntimeError, ValueError) as error:
            print(f"hc-devcontainer: {error}", file=sys.stderr)
            return 2

    parser = argparse.ArgumentParser(prog="hc-devcontainer")
    parser.add_argument("--container", metavar="NAME")
    parser.add_argument("args", nargs="+")
    args = parser.parse_args(argv)
    if args.container:
        if len(args.args) != 1:
            parser.error("--container needs a name and one connection line")
        found = [row for row in rows(inspect(docker, [args.container])) if row["state"] == "running"]
        if not found:
            raise RuntimeError(f"container {args.container!r} is not running")
        return exec_container(docker, found[0], found[0]["name"], args.args[0]) or 0
    if len(args.args) != 2:
        parser.error("expected <folder> <line>, or --container NAME <line>")
    folder, line = args.args
    # ls prints the label as Docker has it; compare real paths so symlinks and slashes match.
    found = [row for row in rows(inspect(docker, folder_ids(docker)))
             if row["state"] == "running" and same_folder(row["folder"], folder)]
    if not found:
        raise RuntimeError(f"no running dev container found for {folder}")
    found.sort(key=lambda row: row["created"], reverse=True)
    if len(found) > 1:
        print(f"hc-devcontainer: {len(found)} containers match; using newest {found[0]['id']}", file=sys.stderr)
    return exec_container(docker, found[0], found[0]["id"], line) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(f"hc-devcontainer: {error}", file=sys.stderr)
        sys.exit(1)
