#!/usr/bin/env python3
"""List Docker containers and run a herdr-core connection line in one.

With the Dev Containers CLI (the engine of VS Code's Dev Containers) on PATH, starting and
connecting go through it, so hooks, userEnvProbe and remoteEnv apply as in VS Code.
"""

import argparse
import json
import os
import posixpath
import re
import shlex
import shutil
import subprocess
import sys
import uuid

FOLDER_LABELS = ("devcontainer.local_folder", "vsch.local.folder")
ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
ENV_REFERENCE = re.compile(r"\$\{(containerEnv|localEnv):([^}:]+)(?::([^}]*))?\}")
WINDOWS = os.name == "nt"
DRIVE_PATH = re.compile(r"([A-Za-z]):(?:[\\/](.*))?\Z", re.S)
# Docker Desktop (WSL 2, Hyper-V) and WSL spell a Windows drive inside Linux.
DRIVE_MOUNT = re.compile(r"/(?:run/desktop/mnt/host|host_mnt|mnt)/([A-Za-z])(?:/(.*))?\Z", re.S)


def metadata(raw):
    try:
        entries = json.loads(raw or "[]")
    except (TypeError, ValueError):
        return []
    if isinstance(entries, dict):
        entries = [entries]
    return [entry for entry in entries if isinstance(entry, dict)] if isinstance(entries, list) else []


def metadata_user(raw):
    remote = container = None
    for entry in metadata(raw):
        if isinstance(entry.get("remoteUser"), str) and entry["remoteUser"]:
            remote = entry["remoteUser"]
        if isinstance(entry.get("containerUser"), str) and entry["containerUser"]:
            container = entry["containerUser"]
    return remote or container


def metadata_has_feature(raw):
    # ghcr.io/o/r/herdr-core:1, ./herdr-core, …/herdr-core@sha256:…
    return any(re.split(r"[:@]", str(entry.get("id", "")).rsplit("/", 1)[-1])[0] == "herdr-core"
               for entry in metadata(raw))


def metadata_remote_env(raw, container_env):
    base = {}
    for item in container_env or []:
        if isinstance(item, str) and "=" in item:
            name, value = item.split("=", 1)
            base[name] = value

    def resolve(match):
        source = base if match[1] == "containerEnv" else os.environ
        return source.get(match[2], match[3] or "")

    remote = {}
    for entry in metadata(raw):
        values = entry.get("remoteEnv")
        if not isinstance(values, dict):
            continue
        for name, value in values.items():
            if not isinstance(name, str) or not ENV_NAME.fullmatch(name):
                continue
            if value is None:
                remote.pop(name, None)
            elif isinstance(value, str):
                remote[name] = ENV_REFERENCE.sub(resolve, value)
    return remote


def base_name(path):
    # Docker Desktop labels hold Windows paths whatever the helper runs on.
    return re.split(r"[\\/]", path.rstrip("\\/"))[-1]


def host_parts(path):
    """A host path as parts; a Windows drive becomes "c:" however it is spelled."""
    if WINDOWS or not DRIVE_PATH.match(path):
        path = os.path.realpath(path)
    drive = DRIVE_PATH.match(path) or DRIVE_MOUNT.match(path)
    if drive:
        return [f"{drive[1].lower()}:", *(p for p in re.split(r"[\\/]", drive[2] or "") if p)]
    return [p for p in re.split(r"[\\/]" if WINDOWS else "/", path) if p]


def folded(parts):
    # Windows paths ignore case.
    return [p.lower() for p in parts] if WINDOWS or (parts and DRIVE_PATH.match(parts[0])) else parts


def machine_name(folder):
    raw = base_name(folder)
    ascii_lower = "".join(c.lower() if c.isascii() else "-" for c in raw)
    name = "".join(c if c.isalnum() or c in "-_." else "-"
                   for c in ascii_lower).lstrip("-_.")[:32]
    # Not "local": shipped Spaces ids its own machine group machine-local.
    if not name or re.fullmatch(r"t[1-9][0123456789bcdfghjkmnpqrstvwxyz]*", name):
        return "container"
    return name


# Sets SHELL from passwd when missing, starts in $2 if given, then runs the connection line $1.
WRAPPER = """if [ -z "${SHELL:-}" ]; then
    unset SHELL
    user=$(id -un)
    if command -v getent >/dev/null 2>&1; then
        shell=$(getent passwd "$user" | awk -F: -v user="$user" '$1 == user { print $7; exit }')
    else
        shell=$(awk -F: -v user="$user" '$1 == user { print $7; exit }' /etc/passwd)
    fi
    [ -z "$shell" ] || export SHELL="$shell"
fi
# stdout carries the connection: cd must never print.
[ "$#" -lt 2 ] || cd -- "$2" >/dev/null 2>&1 || :
exec sh -c "$1"
"""


def exec_argv(docker, container_id, user, line, remote_env=None, workspace=""):
    # Core starts terminals in its own folder when Herdr names none; the image's
    # WORKDIR is often empty (/), so start in the workspace when it exists.
    return [docker, "exec", "-i", *(["-u", user] if user else []),
            *(part for name in (remote_env or {}) if isinstance(name, str) and ENV_NAME.fullmatch(name)
              for part in ("-e", name)),
            container_id, "sh", "-c", WRAPPER, "sh", line, *([workspace] if workspace else [])]


def vscode_user():
    """VS Code's User folder: settings.json, and the extension's record of its engine."""
    configured = os.environ.get("HC_DEVCONTAINER_VSCODE_USER")
    if configured:
        return configured
    base = (os.path.expanduser("~/Library/Application Support") if sys.platform == "darwin"
            else os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"))
    return os.path.join(base, "Code", "User")


def vscode_engine(bin_dir):
    """The CLI VS Code's Dev Containers bundles, run by VS Code's Electron as Node, as its own
    devcontainer command does. The extension rewrites these two files whenever it activates."""
    try:
        with open(os.path.join(bin_dir, "vscode-path"), encoding="utf-8") as stream:
            electron = stream.read().strip()
        with open(os.path.join(bin_dir, "remote-containers-path"), encoding="utf-8") as stream:
            extension = stream.read().strip()
    except (OSError, UnicodeError):
        return None
    script = os.path.join(extension, "dist", "spec-node", "devContainersSpecCLI.js")
    return [electron, script] if os.access(electron, os.X_OK) and os.path.isfile(script) else None


def devcontainer_cli():
    """The Dev Containers CLI as argv, or None for plain docker: HC_DEVCONTAINER_CLI, else VS
    Code's own engine, else a devcontainer command (@devcontainers/cli) on PATH."""
    if WINDOWS:
        # Its npm shim is devcontainer.cmd, and cmd would re-parse the connection line.
        return None
    configured = os.environ.get("HC_DEVCONTAINER_CLI")
    if configured is not None:
        parts = shlex.split(configured)
        return parts if parts and shutil.which(parts[0]) else None
    engine = vscode_engine(os.path.join(vscode_user(), "globalStorage", "ms-vscode-remote.remote-containers", "cli-bin"))
    found = shutil.which("devcontainer")
    if not engine and found:
        # VS Code's installed devcontainer command only opens and builds; the engine is beside it.
        shim = os.path.dirname(os.path.realpath(found))
        if not os.path.exists(os.path.join(shim, "vscode-path")):
            return ["devcontainer"]
        engine = vscode_engine(shim)
    if engine:
        # Every CLI run below, and the exec that replaces this process, needs it.
        os.environ["ELECTRON_RUN_AS_NODE"] = "1"
    return engine


def cli_target(row):
    """Options that let the CLI read this container's devcontainer.json, if this host still has it."""
    labels = row.get("cli_labels") or {}
    folder, config = labels.get("devcontainer.local_folder"), labels.get("devcontainer.config_file")
    if not folder or not os.path.isdir(folder) or (config and not os.path.isfile(config)):
        return []
    # Exact id labels: the CLI must find this container, never build a new one.
    return ["--workspace-folder", folder, *(["--config", config] if config else []),
            *(part for name, value in labels.items() for part in ("--id-label", f"{name}={value}"))]


# VS Code sets this for lifecycle commands and terminals alike.
REMOTE_ENV = ["--remote-env", "REMOTE_CONTAINERS=true"]
# VS Code's copy of a host file into the container: only where none is yet, and only where the
# command that reads it exists. "$1" is the path in the container, "$2" that command.
COPY = """f=$1
[ -e "$f" ] {in_use}&& exit 1
command -v "$2" >/dev/null 2>&1 || exit 1
d=$(dirname "$f")
mkdir -p "$d" && [ -w "$d" ] || exit 1
cat >>"$f"
"""
# A ~/.gitconfig that holds only [filter] or [safe] sections still gets the host's appended.
GITCONFIG_IN_USE = """&& grep -e '^\\[' "$f" | grep -v -E '^\\[(filter|safe)([[:blank:]]+|\\])' >/dev/null """
# VS Code's cleanup after copying git config. VS Code keeps its own `code` editor; Herdr has none.
GIT_CLEANUP = """for key in core.editor core.sshCommand gpg.program gpg.openpgp.program gpg.x509.program gpg.ssh.program
do
\tvalue="$(git config --global --get $key)"
\texecutable="${value%% *}"
\t[ -z "$executable" ] && continue
\tcommand -v "$executable" >/dev/null 2>&1 || (echo "Removing Git config key: $key = $value" && git config --global --unset $key)
done
git config --global --unset http.sslBackend || true
"""


def jsonc(text):
    """VS Code's settings.json (comments, trailing commas) as plain JSON."""
    parts, i = [], 0
    while i < len(text):
        if text[i] == '"':
            j = i + 1
            while j < len(text) and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            parts.append((True, text[i:j + 1]))
            i = j + 1
        elif text.startswith("//", i):
            i = text.find("\n", i) % (len(text) + 1)
        elif text.startswith("/*", i):
            i = (text.find("*/", i + 2) % (len(text) + 1)) + 2
        else:
            parts.append((False, text[i]))
            i += 1
    out, plain = [], ""
    for is_string, piece in parts + [(True, "")]:
        if is_string:
            out += [re.sub(r",(\s*[}\]])", r"\1", plain), piece]
            plain = ""
        else:
            plain += piece
    return "".join(out)


def vscode_settings():
    """The person's VS Code user settings, which VS Code's own open of a container follows."""
    try:
        with open(os.path.join(vscode_user(), "settings.json"), encoding="utf-8") as stream:
            settings = json.loads(jsonc(stream.read()))
    except (OSError, UnicodeError, ValueError):
        return {}
    return settings if isinstance(settings, dict) else {}


def up_argv(cli, docker, target):
    # VS Code's open of an existing container: initializeCommand, then start it (compose: its
    # services). The lifecycle commands follow, phase by phase.
    return [*cli, "up", "--docker-path", docker, *target, "--expect-existing-container", "--skip-post-create"]


def last_json(raw):
    try:
        value = json.loads(raw.decode(errors="replace").strip().splitlines()[-1])
    except (IndexError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def log_file(row):
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    folder = os.path.join(state, "hc-devcontainer")
    os.makedirs(folder, exist_ok=True)
    # Unbuffered: the CLI writes to the same file.
    return open(os.path.join(folder, f"{row['name']}.log"), "wb", buffering=0)


def detach(work, log):
    """Run work in a child that outlives the connection and holds none of core's pipes."""
    if os.fork():
        return
    try:
        os.setsid()
        os.dup2(os.open(os.devnull, os.O_RDONLY), 0)
        os.dup2(log.fileno(), 1)
        os.dup2(log.fileno(), 2)
        work()
    except BaseException as error:  # noqa: BLE001 - the child must always exit here
        os.write(2, f"hc-devcontainer: {error}\n".encode())
    finally:
        for stream in (sys.stdout, sys.stderr):
            try:
                stream.flush()
            except (OSError, ValueError):
                pass
        os._exit(0)


class Session:
    """One connection's version of VS Code's open sequence against one container."""

    def __init__(self, cli, docker, container_id, target, user, log):
        self.cli, self.docker, self.id, self.target, self.user, self.log = cli, docker, container_id, target, user, log
        self.settings = vscode_settings()
        # VS Code caches userEnvProbe per window session in the container the same way.
        self.data = f"/tmp/devcontainers-{uuid.uuid4()}"
        self._home = None

    def note(self, message):
        self.log.write(f"hc-devcontainer: {message}\n".encode())

    def sh(self, script, data=b"", *args):
        """Run a script in the container as the remote user, as VS Code's shell server does."""
        argv = [self.docker, "exec", "-i", *(["-u", self.user] if self.user else []), self.id, "sh", "-c", script, "sh", *args]
        return subprocess.run(argv, input=data, stdout=self.log, stderr=self.log, check=False).returncode

    def cli_sh(self, script, data=b""):
        # With the userEnvProbe environment, so tools on the user's PATH are found.
        argv = [*self.cli, "exec", "--docker-path", self.docker, "--container-id", self.id, *self.target,
                *REMOTE_ENV, "sh", "-c", script]
        return subprocess.run(argv, input=data, stdout=self.log, stderr=self.log, check=False).returncode

    def copy(self, host, remote, needs, in_use=""):
        try:
            with open(host, "rb") as stream:
                data = stream.read()
        except OSError:
            return False
        return self.sh(COPY.format(in_use=in_use), data, remote, needs) == 0

    def dotfiles(self):
        flags = {"repository": "--dotfiles-repository", "installCommand": "--dotfiles-install-command",
                 "targetPath": "--dotfiles-target-path"}
        values = {flag: self.settings.get(f"dotfiles.{key}") for key, flag in flags.items()}
        if not (isinstance(values["--dotfiles-repository"], str) and values["--dotfiles-repository"]):
            return []
        return [part for flag, value in values.items() if isinstance(value, str) and value for part in (flag, value)]

    def hooks(self, blocking, stop):
        """One phase of the lifecycle commands; returns where the CLI stopped, or None on failure."""
        argv = [*self.cli, "run-user-commands", "--docker-path", self.docker, "--container-id", self.id,
                *self.target, *REMOTE_ENV, "--container-session-data-folder", self.data, *self.dotfiles(),
                *(["--skip-non-blocking-commands"] if blocking else []),
                *(["--stop-for-personalization"] if stop else [])]
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=self.log, check=False)
        self.log.write(result.stdout)
        if result.returncode:
            self.note("a lifecycle command failed; the rest are skipped")
            return None
        return last_json(result.stdout).get("result")

    def home(self):
        # The remote user's home; docker exec -u sets HOME from passwd.
        if self._home is None:
            found = subprocess.run([self.docker, "exec", *(["-u", self.user] if self.user else []), self.id,
                                    "sh", "-c", 'printf %s "$HOME"'], capture_output=True, check=False)
            self._home = found.stdout.decode(errors="replace") if not found.returncode and found.stdout else "/root"
        return self._home

    def known_hosts(self):
        host = os.path.join(os.path.expanduser("~"), ".ssh", "known_hosts")
        self.copy(host, posixpath.join(self.home(), ".ssh", "known_hosts"), "ssh")

    def personalize(self):
        """What VS Code does after dotfiles: copy the host's git config, unless that is turned off."""
        if self.settings.get("dev.containers.copyGitConfig", True) is False:
            return
        home, remote = os.path.expanduser("~"), self.home()
        xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
        copied = self.copy(os.path.join(home, ".gitconfig"), posixpath.join(remote, ".gitconfig"), "git",
                           GITCONFIG_IN_USE)
        copied = self.copy(os.path.join(xdg, "git", "config"), posixpath.join(remote, ".config", "git", "config"),
                           "git") or copied
        if not copied:
            return
        self.sh(GIT_CLEANUP)
        signers = host_git_config("gpg.ssh.allowedSignersFile")
        if signers:
            path = os.path.abspath(os.path.join(home, os.path.expanduser(signers)))
            inside = posixpath.normpath(posixpath.join(remote, os.path.relpath(path, home).replace(os.sep, "/")))
            if self.copy(path, inside, "ssh"):
                self.sh('git config --global gpg.ssh.allowedSignersFile "$1"', b"", inside)

    def gh_login(self):
        """VS Code logs the container's GitHub CLI in with the host's token, unless turned off."""
        if self.settings.get("dev.containers.githubCLILoginWithToken", True) is False or not shutil.which("gh"):
            return
        if self.cli_sh("command -v gh >/dev/null 2>&1 && ! gh auth status >/dev/null 2>&1"):
            return
        token = subprocess.run(["gh", "auth", "token"], capture_output=True, check=False)
        if not token.returncode and token.stdout.strip():
            self.cli_sh("gh auth login --with-token", token.stdout.strip())


def host_git_config(key):
    if not shutil.which("git"):
        return ""
    found = subprocess.run(["git", "config", "--global", "--get", key], capture_output=True, text=True, check=False)
    return found.stdout.rstrip("\r\n") if not found.returncode else ""


def open_like_vs_code(cli, docker, row, container_id, target):
    """VS Code's open sequence; returns the exec target, or None if the CLI cannot run."""
    log = log_file(row)
    user = row["user"]
    if target:
        up = subprocess.run(up_argv(cli, docker, target), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=log, check=False)
        log.write(up.stdout)
        if up.returncode == 127:
            print("hc-devcontainer: the devcontainer CLI cannot run; using docker exec", file=sys.stderr)
            return None
        if up.returncode:
            print(f"hc-devcontainer: devcontainer up failed; lifecycle commands skipped (see {log.name})",
                  file=sys.stderr)
            target = []
        else:
            user = last_json(up.stdout).get("remoteUser") or user
    session = Session(cli, docker, container_id, target, user, log)
    session.known_hosts()
    first = then = None
    if target:
        # VS Code's phases: blocking commands (to waitFor) and personalization before the window
        # connects; the rest in the background. The CLI's markers keep each command to its once.
        first = session.hooks(blocking=True, stop=True)
        if first == "stopForPersonalization":
            session.personalize()
            then = session.hooks(blocking=True, stop=False)
    else:
        session.personalize()

    def background():
        session.gh_login()
        if first == "skipNonBlocking":
            if session.hooks(blocking=False, stop=True) == "stopForPersonalization":
                session.personalize()
                session.hooks(blocking=False, stop=False)
        elif then == "skipNonBlocking":
            session.hooks(blocking=False, stop=False)

    detach(background, log)
    return target


def connect(docker, row, container_id, line):
    """Open and attach the way VS Code does, then exec with its user, env and folder."""
    cli = devcontainer_cli()
    target = open_like_vs_code(cli, docker, row, container_id, cli_target(row)) if cli else None
    if target is None:
        return exec_container(docker, row, container_id, line)
    # The CLI sets remoteUser, userEnvProbe and remoteEnv, and with the config, the workspace folder.
    workspace = [] if target or not row.get("workspace") else [row["workspace"]]
    argv = [*cli, "exec", "--docker-path", docker, "--container-id", container_id, *target, *REMOTE_ENV,
            "sh", "-c", WRAPPER, "sh", line, *workspace]
    os.execvp(argv[0], argv)


def start(docker, container_id):
    cli = devcontainer_cli()
    found = rows(inspect(docker, [container_id])) if cli else []
    target = cli_target(found[0]) if found else []
    if target:
        result = subprocess.run(up_argv(cli, docker, target), stdin=subprocess.DEVNULL,
                                capture_output=True, check=False)
        if not result.returncode:
            return
        message = last_json(result.stdout).get("message") or result.stderr.decode(errors="replace").strip()
        print(f"hc-devcontainer: devcontainer up failed ({message or result.returncode}); using docker start",
              file=sys.stderr)
    run([docker, "start", container_id])


def exec_container(docker, row, container_id, line):
    remote = {name: value for name, value in row.get("remote_env", {}).items()
              if isinstance(name, str) and ENV_NAME.fullmatch(name)}
    env = {**os.environ, **remote}
    # A remote PATH must not change where the host finds Docker.
    executable = (shutil.which(docker) or docker) if "PATH" in remote else docker
    argv = exec_argv(docker, container_id, row["user"], line, remote, row.get("workspace"))
    if WINDOWS:
        # Windows has no exec: os.exec* starts a child and exits at once, ending the connection.
        return subprocess.run([executable, *argv[1:]], env=env, check=False).returncode
    os.execvpe(executable, argv, env)


def shell_quote(value):
    return "'" + value.replace("'", "'\\''") + "'"


def same_folder(a, b):
    return folded(host_parts(a)) == folded(host_parts(b))


def workspace_for(folder, mounts, working_dir, devcontainer=False, repo_folder=""):
    best = None
    if folder:
        parts = host_parts(folder)
        key = folded(parts)
        for mount in mounts:
            if mount.get("Type", "bind") != "bind":
                continue
            source, dest = mount.get("Source"), mount.get("Destination")
            if not source or not dest:
                continue
            source = folded(host_parts(source))
            if key[:len(source)] == source and (best is None or len(source) > best[0]):
                best = (len(source), dest)
    if best:
        depth, dest = best
        return posixpath.normpath(posixpath.join(dest, *parts[depth:]))
    if devcontainer:
        dests = {posixpath.normpath(m.get("Destination") or "/") for m in mounts}
        # VS Code's Clone in Volume: the volume is /workspaces, the repo a folder in it.
        if repo_folder not in ("", ".", "..") and "/" not in repo_folder and "/workspaces" in dests:
            return f"/workspaces/{repo_folder}"
        # A repo mounted from elsewhere at /workspaces/<name>: only a guess, so only when the
        # image names no folder of its own, and only when unambiguous.
        found = sorted(d for d in dests if posixpath.dirname(d) == "/workspaces"
                       and (working_dir or "/") == "/")
        named = f"/workspaces/{base_name(folder)}" if folder else None
        if named in found:
            return named
        if len(found) == 1:
            return found[0]
    return working_dir if working_dir and working_dir != "/" else ""


def run(argv):
    try:
        result = subprocess.run(argv, capture_output=True, text=True, check=False)
    except OSError as error:
        raise RuntimeError(f"cannot run {argv[0]}: {error}") from error
    if result.returncode:
        raise RuntimeError((result.stderr or f"{argv[0]} {argv[1]} failed").strip())
    return result.stdout


def ps(docker, *extra):
    return run([docker, "ps", "-q", *extra]).split()


def folder_ids(docker, *extra):
    return [i for label in FOLDER_LABELS for i in ps(docker, *extra, "--filter", f"label={label}")]


def inspect(docker, ids):
    ids = list(dict.fromkeys(ids))
    if not ids:
        return []
    output = run([docker, "inspect", "--type", "container", *ids])
    try:
        return json.loads(output)
    except ValueError as error:
        raise RuntimeError(f"invalid {docker} inspect output: {error}") from error


def rows(containers):
    found = []
    for item in containers:
        docker_state = item.get("State") or {}
        state = docker_state.get("Status") or ("running" if docker_state.get("Running", True) else "exited")
        config = item.get("Config") or {}
        labels = config.get("Labels") or {}
        folder = labels.get("devcontainer.local_folder") or labels.get("vsch.local.folder") or ""
        raw = labels.get("devcontainer.metadata")
        # Folderless CLI builds use vsc-* images; metadata on other images alone is insufficient.
        devcontainer = bool(folder or "vsch.local.repository" in labels
                            or ("devcontainer.metadata" in labels and re.fullmatch(r"vsc-.+", config.get("Image") or "")))
        name = item.get("Name", "").lstrip("/")
        row = {
            "folder": folder,
            "name": name,
            "id": item["Id"],
            "kind": "devcontainer" if devcontainer else "container",
            "state": state,
            "has_feature": devcontainer and metadata_has_feature(raw),
            "workspace": workspace_for(folder, item.get("Mounts") or [], config.get("WorkingDir"), devcontainer,
                                       labels.get("vsch.local.repository.folder") or ""),
            "user": metadata_user(raw) or config.get("User") or None,
            "image": config.get("Image", ""),
            "via": f"hc-devcontainer {shell_quote(folder)}" if folder else f"hc-devcontainer --container {shell_quote(name)}",
            "suggested_name": machine_name(folder if folder else name),
            "created": item.get("Created", ""),
        }
        cli_labels = {key: labels[key] for key in ("devcontainer.local_folder", "devcontainer.config_file")
                      if labels.get(key)}
        if cli_labels:
            row["cli_labels"] = cli_labels
        remote_env = metadata_remote_env(raw, config.get("Env"))
        if remote_env:
            row["remote_env"] = remote_env
        found.append(row)
    found.sort(key=lambda row: (row["kind"] != "devcontainer", row["folder"], row["name"]))
    seen = set()
    for row in found:
        base = row["suggested_name"]
        name = base
        suffix = 2
        while name in seen:
            tail = f"-{suffix}"
            name = f"{base[:32 - len(tail)]}{tail}"
            suffix += 1
        row["suggested_name"] = name
        seen.add(name)
    return found


def exists(docker, via):
    """0: the via's container exists (any state), 1: it is gone; errors raise."""
    parts = shlex.split(via)
    if parts[:1] != ["hc-devcontainer"] or len(parts) != (3 if parts[1:2] == ["--container"] else 2):
        raise ValueError(f"not an hc-devcontainer via: {via!r}")
    if len(parts) == 2:
        found = [row for row in rows(inspect(docker, folder_ids(docker, "-a"))) if same_folder(row["folder"], parts[1])]
        return 0 if found else 1
    try:
        inspect(docker, [parts[2]])
    except RuntimeError as error:
        if "no such" in str(error).lower():  # docker: No such object/container; podman: no such container
            return 1
        raise
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    docker = os.environ.get("HC_DEVCONTAINER_DOCKER") or "docker"
    if argv and argv[0] == "ls":
        parser = argparse.ArgumentParser(prog="hc-devcontainer ls")
        parser.add_argument("--all", action="store_true")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args(argv[1:])
        # Running and paused containers, and with --all stopped dev ones too.
        ids = ps(docker) + (folder_ids(docker, "-a") + ps(docker, "-a", "--filter", "label=devcontainer.metadata") if args.all else [])
        found = rows(inspect(docker, ids))
        if args.all:
            found = [row for row in found if row["kind"] == "devcontainer" or row["state"] in ("running", "paused")]
        if not args.all:
            found = [row for row in found if row["kind"] == "devcontainer" and row["state"] == "running"]
        if args.json:
            for row in found:
                row.pop("created")
                row.pop("remote_env", None)
                row.pop("cli_labels", None)
            print(json.dumps(found))
        else:
            for row in found:
                print(f"{row['suggested_name']}\t{row['folder']}\t{row['name']}\t{row['id']}")
        return 0

    if argv and argv[0] == "start":
        parser = argparse.ArgumentParser(prog="hc-devcontainer start")
        parser.add_argument("id")
        args = parser.parse_args(argv[1:])
        start(docker, args.id)
        return 0

    if argv and argv[0] == "exists":
        parser = argparse.ArgumentParser(prog="hc-devcontainer exists",
                                         description="Exit 0 if the container exists, 1 if gone, 2 on error.")
        parser.add_argument("via")
        args = parser.parse_args(argv[1:])
        try:
            return exists(docker, args.via)
        except (RuntimeError, ValueError) as error:
            print(f"hc-devcontainer: {error}", file=sys.stderr)
            return 2

    parser = argparse.ArgumentParser(prog="hc-devcontainer")
    parser.add_argument("--container", metavar="NAME")
    parser.add_argument("args", nargs="+")
    args = parser.parse_args(argv)
    if args.container:
        if len(args.args) != 1:
            parser.error("--container needs a name and one connection line")
        found = [row for row in rows(inspect(docker, [args.container])) if row["state"] == "running"]
        if not found:
            raise RuntimeError(f"container {args.container!r} is not running")
        return connect(docker, found[0], found[0]["name"], args.args[0]) or 0
    if len(args.args) != 2:
        parser.error("expected <folder> <line>, or --container NAME <line>")
    folder, line = args.args
    # ls prints the label as Docker has it; compare real paths so symlinks and slashes match.
    found = [row for row in rows(inspect(docker, folder_ids(docker)))
             if row["state"] == "running" and same_folder(row["folder"], folder)]
    if not found:
        raise RuntimeError(f"no running dev container found for {folder}")
    found.sort(key=lambda row: row["created"], reverse=True)
    if len(found) > 1:
        print(f"hc-devcontainer: {len(found)} containers match; using newest {found[0]['id']}", file=sys.stderr)
    return connect(docker, found[0], found[0]["id"], line) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(f"hc-devcontainer: {error}", file=sys.stderr)
        sys.exit(1)
