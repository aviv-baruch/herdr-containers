index 0000000..ed160cc
--- /dev/null
+++ b/src/wsl_gpu.rs
@@ -0,0 +1,107 @@
+//! WSL2 reaches the GPU only through /dev/dxg, in Direct3D 12. Ubuntu's Mesa
+//! has no Vulkan driver for it, and its OpenGL default (zink) refuses the CPU
+//! Vulkan driver, so wgpu drew on lavapipe: every frame on the CPU. Mesa's
+//! d3d12 OpenGL driver is installed but only used when named, so the window
+//! names it. Programs the app starts never see that choice.
+
+use std::ffi::OsString;
+use std::process::Command;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+const DRIVER: &str = "GALLIUM_DRIVER";
+/// Mesa choices of the person's own; any of them, even empty, leaves Mesa alone.
+const CHOSEN: [&str; 3] = [DRIVER, "LIBGL_ALWAYS_SOFTWARE", "MESA_LOADER_DRIVER_OVERRIDE"];
+static NAMED: AtomicBool = AtomicBool::new(false);
+
+/// In WSL2, draws through d3d12 unless the person chose a Mesa driver.
+/// Call before any thread starts: it sets an environment variable.
+pub fn startup() {
+    if !cfg!(target_os = "linux") {
+        return;
+    }
+    let release = std::fs::read_to_string("/proc/sys/kernel/osrelease").unwrap_or_default();
+    if wants_d3d12(&release, std::path::Path::new("/dev/dxg").exists(), |name: &str| std::env::var_os(name)) {
+        // SAFETY: main calls this before any thread starts.
+        unsafe { std::env::set_var(DRIVER, "d3d12") };
+        NAMED.store(true, Ordering::Relaxed);
+        tracing::info!("WSL: drawing on the GPU through Direct3D 12 ({DRIVER}=d3d12; set {DRIVER} to choose another driver)");
+    }
+}
+
+/// WSL (its kernel, or a session it started) with the GPU channel, and no driver chosen.
+fn wants_d3d12(release: &str, dxg: bool, var: impl Fn(&str) -> Option<OsString>) -> bool {
+    let release = release.to_ascii_lowercase();
+    let wsl = release.contains("microsoft") || release.contains("wsl") || var("WSL_DISTRO_NAME").is_some();
+    wsl && dxg && CHOSEN.iter().all(|name| var(name).is_none())
+}
+
+/// Keeps the window's driver out of a program the app starts: the core (and
+/// so every terminal), mods' programs, link openers, the relaunched app.
+pub fn hide(command: &mut Command) {
+    hide_if(command, NAMED.load(Ordering::Relaxed));
+}
+
+fn hide_if(command: &mut Command, named: bool) {
+    if named {
+        command.env_remove(DRIVER);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WSL2: &str = "6.6.87.2-microsoft-standard-WSL2\n";
+    const LINUX: &str = "6.8.0-48-generic\n";
+
+    fn env<'a>(vars: &'a [(&'a str, &'a str)]) -> impl Fn(&str) -> Option<OsString> + 'a {
+        move |name| vars.iter().find(|(key, _)| *key == name).map(|(_, value)| value.into())
+    }
+
+    fn removed(command: &Command) -> bool {
+        command.get_envs().any(|(key, value)| key == DRIVER && value.is_none())
+    }
+
+    #[test]
+    fn wsl2_with_its_gpu_channel_draws_through_d3d12() {
+        assert!(wants_d3d12(WSL2, true, env(&[])));
+        // A custom kernel: the session WSL started still says so.
+        assert!(wants_d3d12("6.18.0-custom\n", true, env(&[("WSL_DISTRO_NAME", "Ubuntu")])));
+    }
+
+    #[test]
+    fn other_linux_and_wsl_without_its_gpu_keep_their_driver() {
+        assert!(!wants_d3d12(LINUX, false, env(&[])));
+        // A Linux VM with a GPU partition has /dev/dxg too, but is not WSL.
+        assert!(!wants_d3d12(LINUX, true, env(&[])));
+        // WSL1, or WSL2 with its GPU turned off: no /dev/dxg to draw on.
+        assert!(!wants_d3d12("4.4.0-19041-Microsoft\n", false, env(&[("WSL_DISTRO_NAME", "Ubuntu")])));
+        assert!(!wants_d3d12(WSL2, false, env(&[])));
+    }
+
+    #[test]
+    fn a_mesa_driver_the_person_chose_wins_even_empty() {
+        for name in CHOSEN {
+            for value in ["llvmpipe", "1", ""] {
+                assert!(!wants_d3d12(WSL2, true, env(&[(name, value)])), "{name}={value:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn programs_keep_the_environment_they_had() {
+        let mut ours = Command::new("true");
+        hide_if(&mut ours, true);
+        assert!(removed(&ours));
+        let mut persons = Command::new("true");
+        hide_if(&mut persons, false);
+        assert_eq!(persons.get_envs().count(), 0);
+    }
+
+    #[test]
+    fn programs_started_through_spawn_command_never_see_the_windows_driver() {
+        // Never cleared: removing a variable nobody set changes nothing for other tests.
+        NAMED.store(true, Ordering::Relaxed);
+        assert!(removed(&crate::spawn::command("true")));
+    }
+}
